# ── App ─────────────────────────────────────────────
APP_NAME="OrderlyAI API"
ENV=local                # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database (Postgres in Docker) ───────────────────
DATABASE_URL=postgresql+asyncpg://orderlyai:orderlyai@localhost:55432/orderlyai

# ── Auth / JWT ──────────────────────────────────────
# Generate a strong secret for non-local: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS (frontend origins, comma-separated) ────────
CORS_ORIGINS=http://localhost:3000

# Local upload storage for menu item images
UPLOAD_DIR=uploads
MAX_PRODUCT_IMAGE_BYTES=2000000

# WhatsApp Cloud API webhook verification token. You create this value and paste
# the same value into Meta's webhook Verify token field.
WHATSAPP_VERIFY_TOKEN=change-me-for-local-whatsapp-webhook
# Meta App Secret (App Dashboard -> App settings -> Basic). Verifies the
# X-Hub-Signature-256 header on inbound webhooks. Inbound POSTs are rejected
# (503) until this is set, then rejected (403) unless the signature matches.
WHATSAPP_APP_SECRET=
# Fernet key encrypting stored WhatsApp access tokens at rest. Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it secret and stable — rotating it makes existing stored tokens undecryptable.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# ── AI agent (LangChain v1) ─────────────────────────
# Provider: "openrouter" (one key, many models) or "anthropic" (direct).
LLM_PROVIDER=openrouter

# OpenRouter (when LLM_PROVIDER=openrouter). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Anthropic (when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# Model ids. OpenRouter slugs (e.g. anthropic/claude-sonnet-4.6, openai/gpt-5.5) when
# LLM_PROVIDER=openrouter; "anthropic:<model>" when LLM_PROVIDER=anthropic.
# main = default, escalation = hard turns, summary = cheap history compaction.
AGENT_MODEL=anthropic/claude-sonnet-4.6
AGENT_ESCALATION_MODEL=anthropic/claude-opus-4.1
AGENT_SUMMARY_MODEL=anthropic/claude-3.5-haiku

# ── LangSmith (tracing + evals, optional) ───────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderlyai
