# ── App ─────────────────────────────────────────────
APP_NAME="OrderlyAI API"
ENV=local                # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database (Postgres in Docker) ───────────────────
DATABASE_URL=postgresql+asyncpg://orderlyai:orderlyai@localhost:55432/orderlyai

# ── Auth / JWT ──────────────────────────────────────
# Generate a strong secret for non-local: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS (frontend origins, comma-separated) ────────
CORS_ORIGINS=http://localhost:3000

# Local upload storage for menu item images
UPLOAD_DIR=uploads
MAX_PRODUCT_IMAGE_BYTES=2000000

# WhatsApp Cloud API webhook verification token. You create this value and paste
# the same value into Meta's webhook Verify token field.
WHATSAPP_VERIFY_TOKEN=change-me-for-local-whatsapp-webhook
# Meta App Secret (App Dashboard -> App settings -> Basic). Verifies the
# X-Hub-Signature-256 header on inbound webhooks. Inbound POSTs are rejected
# (503) until this is set, then rejected (403) unless the signature matches.
WHATSAPP_APP_SECRET=
# Fernet key encrypting stored WhatsApp access tokens at rest. Generate with:
#   python -c "import base64,os; print(base64.urlsafe_b64encode(os.urandom(32)).decode())"
# Keep it secret and stable — rotating it makes existing stored tokens undecryptable.
WHATSAPP_TOKEN_ENCRYPTION_KEY=

# ── AI agent (LangChain v1) ─────────────────────────
# Provider: "openrouter" (one key, many models) or "anthropic" (direct).
LLM_PROVIDER=openrouter

# OpenRouter (when LLM_PROVIDER=openrouter). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Direct Anthropic (when LLM_PROVIDER=anthropic).
ANTHROPIC_API_KEY=

# Model ids. OpenRouter slugs (e.g. anthropic/claude-sonnet-4.6, openai/gpt-5.5) when
# LLM_PROVIDER=openrouter; "anthropic:<model>" when LLM_PROVIDER=anthropic.
# main = default, escalation = hard turns, summary = cheap history compaction.
AGENT_MODEL=anthropic/claude-sonnet-4.6
AGENT_ESCALATION_MODEL=anthropic/claude-opus-4.1
AGENT_SUMMARY_MODEL=anthropic/claude-haiku-4.5

# History compaction (summarization) — a safety valve, not a per-turn step. Summarize when
# history reaches TRIGGER_TOKENS, keep the most recent KEEP_MESSAGES verbatim, trim the block
# sent to the summary model to TRIM_TOKENS. Size TRIGGER_TOKENS to your model's context window
# (~70-80% of it, with a ~50k floor so short chats never thrash); on a 1M-context model keep it
# high so normal orders are never summarized. Use a CHEAP summary model (Haiku/Flash), never the
# main model. Keep TRIM_TOKENS >= TRIGGER_TOKENS so the summary input isn't truncated.
AGENT_SUMMARY_TRIGGER_TOKENS=50000
AGENT_SUMMARY_KEEP_MESSAGES=30
AGENT_SUMMARY_TRIM_TOKENS=50000
# Per-turn ceiling on model calls (loop/cost guard).
AGENT_MAX_MODEL_CALLS=12
# Context editing (model-agnostic): once history passes TRIGGER_TOKENS, clear OLD tool
# outputs from what's sent to the model, keeping the most recent KEEP. Trims repeated
# menu/cart dumps without rewriting stored history; set below the summary trigger.
AGENT_CONTEXT_EDIT_TRIGGER_TOKENS=3000
AGENT_CONTEXT_EDIT_KEEP=3
# Cache the per-tenant prompt snapshot (facts + menu) for this many seconds to avoid
# reloading it on every model call (0 disables). Order-time guards re-check the DB live.
AGENT_SNAPSHOT_TTL_SECONDS=15
# Inline the menu into the prompt when its rendered text is within this many chars (so the
# agent answers from context instead of calling get_menu); larger menus fall back to the
# tool. 0 disables preloading.
AGENT_MENU_PRELOAD_MAX_CHARS=8000

# ── Agent durable memory + inbound worker ───────────
# Use the Postgres checkpointer (durable across restarts) instead of in-process memory,
# and start the inbound worker (durable inbox + sweeper) on app startup. Tests force these
# off via RUN_AGENT_WORKER=false.
WHATSAPP_DURABLE_MEMORY=true
RUN_AGENT_WORKER=true
# Inbound processing: brief debounce to coalesce a burst into one turn (0 = prompt),
# dead-letter after N failed attempts, and how often the sweeper re-drives pending rows.
WHATSAPP_COALESCE_SECONDS=0
WHATSAPP_INBOX_MAX_ATTEMPTS=5
WHATSAPP_INBOX_SWEEP_SECONDS=30
# Cap concurrent conversation drains (each holds 2 DB connections) so a webhook burst can't
# exhaust the pool.
WHATSAPP_MAX_CONCURRENT_DRAINS=6
# Auto-resume the bot this many hours after a human handoff + customer silence (0 = never).
WHATSAPP_HANDOFF_MUTE_HOURS=24
# Retention: purge the inbox rows + LangGraph checkpoint for a conversation inactive this many
# days (0 disables), and how often to run the purge. Bounds per-customer storage growth.
WHATSAPP_RETENTION_DAYS=90
WHATSAPP_RETENTION_SWEEP_HOURS=24
# Meta free-form customer-service window (hours) + per-customer inbound rate limit (/min)
# + outbound send retry count.
WHATSAPP_CUSTOMER_WINDOW_HOURS=24
WHATSAPP_RATE_LIMIT_PER_MIN=20
WHATSAPP_SEND_MAX_RETRIES=3

# Proactive notifications outside the 24h window need pre-approved templates. Leave the
# names unset to skip out-of-window pushes (in-window text confirmations still send).
WHATSAPP_TEMPLATE_LANG=en
WHATSAPP_ORDER_CONFIRM_TEMPLATE=
WHATSAPP_ORDER_STATUS_TEMPLATE=

# Agent prompt (LangSmith Prompt Hub). Code is the source of truth; `uv run python
# sync_prompt.py` pushes the in-code template to AGENT_PROMPT_NAME for versioning/Playground.
# Set AGENT_PROMPT_REF (e.g. orderlyai-agent:production) to pull-override at runtime; unset
# = always use the in-code template.
AGENT_PROMPT_NAME=orderlyai-agent
AGENT_PROMPT_REF=

# ── LangSmith (tracing + evals, optional) ───────────
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=orderlyai
