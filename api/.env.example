# ── App ─────────────────────────────────────────────
APP_NAME="OrderlyAI API"
ENV=local                # local | staging | production
DEBUG=true
API_V1_PREFIX=/api/v1

# ── Database (Postgres in Docker) ───────────────────
DATABASE_URL=postgresql+asyncpg://orderlyai:orderlyai@localhost:55432/orderlyai

# ── Auth / JWT ──────────────────────────────────────
# Generate a strong secret for non-local: `python -c "import secrets; print(secrets.token_urlsafe(48))"`
JWT_SECRET=change-me-please-use-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14

# ── CORS (frontend origins, comma-separated) ────────
CORS_ORIGINS=http://localhost:3000
